{
    "name": "aihimel/laravel-waiting-request",
    "description": "A simple implementation for holding request untill a job or background process is done.",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Aftabul Islam",
            "email": "toaihimel@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "illuminate/support": "^13.8"
    },
    "require-dev": {
        "orchestra/testbench": "^11.1"
    },
    "autoload": {
        "psr-4": {
            "Aihimel\\LaravelWaitingRequest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aihimel\\LaravelWaitingRequest\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aihimel\\LaravelWaitingRequest\\LWRequestServiceProvider"
            ],
            "aliases": {
                "LWRequest": "Aihimel\\LaravelWaithingRequest\\Facades\\LWRequest"
            }
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    }
}